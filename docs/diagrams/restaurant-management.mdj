							"height": 42,
							"text": "Dashed arrow: client depends on supplier. Logical dependencies do not show execution sequence."
						},
						{
							"_type": "UMLNoteView",
							"_id": "note-1433",
							"_parent": {
								"$ref": "UMLComponentDiagram-1291"
